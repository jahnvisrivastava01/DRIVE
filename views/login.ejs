<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Login</title>

    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link href="https://cdn.jsdelivr.net/npm/remixicon@4.9.0/fonts/remixicon.css" rel="stylesheet">
</head>

<body class="min-h-screen bg-gradient-to-br from-slate-950 via-slate-900 to-slate-800 flex items-center justify-center">

    <div class="bg-slate-900 border border-slate-700 rounded-3xl p-8 w-96 shadow-xl">

        <div class="text-center">

            <div class="w-20 h-20 rounded-full bg-blue-600/20 flex items-center justify-center mx-auto">
                <i class="ri-cloud-line text-5xl text-blue-500"></i>
            </div>

            <h1 class="text-white text-3xl font-bold mt-5">
                Welcome Back
            </h1>

            <p class="text-slate-400 mt-2">
                Login to your Drive account
            </p>

        </div>

        <form action="/user/login" method="post" class="mt-8 space-y-5">

            <div>

                <label class="text-slate-300">Username</label>

                <input type="text" name="username" required
                    class="w-full mt-2 p-3 rounded-xl bg-slate-800 border border-slate-700 text-white">

            </div>

            <div>

                <label class="text-slate-300">Password</label>

                <input type="password" name="password" required
                    class="w-full mt-2 p-3 rounded-xl bg-slate-800 border border-slate-700 text-white">

            </div>

            <button type="submit" class="w-full bg-blue-600 hover:bg-blue-700 py-3 rounded-xl text-white">

                Login

            </button>

        </form>

        <p class="text-center text-slate-400 mt-6">

            Don't have an account?

            <a href="/user/register" class="text-blue-400">

                Register

            </a>

        </p>

    </div>

</body>

</html>