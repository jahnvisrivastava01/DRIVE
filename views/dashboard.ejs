<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Drive Dashboard</title>

    <link rel="stylesheet" href="/css/output.css">

    <link href="https://cdn.jsdelivr.net/npm/remixicon@4.9.0/fonts/remixicon.css" rel="stylesheet">
</head>

<body class="bg-slate-100 min-h-screen flex flex-col">

    <div class="flex flex-1">

        <div id="overlay" class="fixed inset-0 bg-black/40 z-40 hidden lg:hidden" onclick="toggleSidebar()"></div>


        <aside id="sidebar" class="fixed lg:static top-0 left-0 z-50
        w-72 h-screen bg-white border-r border-slate-200
        flex flex-col
        -translate-x-full lg:translate-x-0
        transition-transform duration-300">



            <div class="px-8 py-7 flex items-center gap-3 border-b">

                <div class="w-12 h-12 rounded-xl bg-blue-600 flex items-center justify-center">

                    <i class="ri-cloud-line text-white text-3xl"></i>

                </div>

                <h1 class="text-4xl font-bold">

                    Drive

                </h1>

            </div>



            <div class="px-6 mt-6 relative">

                <button onclick="toggleNewMenu()" class="w-full flex items-center justify-center gap-3
        bg-white border border-slate-200 rounded-2xl py-4
        shadow hover:shadow-lg transition">

                    <i class="ri-add-line text-2xl"></i>

                    <span class="font-semibold">New</span>

                </button>



                <div id="newMenu"
                    class="hidden absolute left-6 right-6 mt-2 bg-white rounded-xl shadow-xl border border-slate-200 overflow-hidden z-50">

                    <button onclick="document.getElementById('fileInput').click()"
                        class="w-full px-5 py-3 text-left hover:bg-slate-100 flex items-center gap-3">

                        <i class="ri-upload-cloud-line text-blue-600"></i>

                        Upload File

                    </button>

                    <button disabled
                        class="w-full px-5 py-3 text-left text-slate-400 flex items-center gap-3 cursor-not-allowed">

                        <i class="ri-folder-add-line"></i>

                        New Folder (Coming Soon)

                    </button>

                </div>

            </div>


            <nav class="mt-10 px-3 space-y-2">

                <a href="/dashboard" class="flex items-center gap-4 px-4 py-3 rounded-xl
                <%= page==='Home'
                ? 'bg-blue-50 text-blue-600 font-semibold'
                : 'hover:bg-slate-100' %>">

                    <i class="ri-home-5-line text-xl"></i>

                    Home

                </a>

                <a href="/recent" class="flex items-center gap-4 px-4 py-3 rounded-xl
                <%= page==='Recent'
                ? 'bg-blue-50 text-blue-600 font-semibold'
                : 'hover:bg-slate-100' %>">

                    <i class="ri-history-line text-xl"></i>

                    Recent

                </a>

                <a href="/starred" class="flex items-center gap-4 px-4 py-3 rounded-xl
                <%= page==='Starred'
                ? 'bg-blue-50 text-blue-600 font-semibold'
                : 'hover:bg-slate-100' %>">

                    <i class="ri-star-line text-xl"></i>

                    Starred

                </a>

                <a href="/trash" class="flex items-center gap-4 px-4 py-3 rounded-xl
                <%= page==='Trash'
                ? 'bg-blue-50 text-blue-600 font-semibold'
                : 'hover:bg-slate-100' %>">

                    <i class="ri-delete-bin-line text-xl"></i>

                    Trash

                </a>

            </nav>



            <div class="mt-auto border-t p-6">

                <a href="/user/logout" class="flex items-center gap-4 px-4 py-3 rounded-xl
                text-red-500 hover:bg-red-50">

                    <i class="ri-logout-box-line"></i>

                    Logout

                </a>

            </div>

        </aside>



        <main class="flex-1 flex flex-col min-w-0">



            <header class="bg-white border-b border-slate-200
            px-4 md:px-8 py-5
            flex items-center justify-between gap-4">



                <div class="flex items-center gap-4 flex-1">


                    <button onclick="toggleSidebar()" class="lg:hidden text-3xl">

                        <i class="ri-menu-line"></i>

                    </button>



                    <form action="/search" method="GET" class="flex items-center gap-3
                    bg-slate-100
                    rounded-full
                    px-5 py-3
                    w-full
                    max-w-xl">

                        <i class="ri-search-line text-slate-500"></i>

                        <input type="text" name="q" value="<%= typeof query !== 'undefined' ? query : '' %>"
                            placeholder="Search in Drive..." class="bg-transparent outline-none w-full">

                    </form>

                </div>



                <div class="flex items-center gap-3">

                    <div class="hidden sm:block text-right">

                        <h2 class="font-semibold">

                            <%= user.username %>

                        </h2>

                        <p class="text-sm text-slate-500">

                            <%= user.email %>

                        </p>

                    </div>

                    <div class="w-11 h-11 rounded-full
                    bg-blue-600
                    text-white
                    flex items-center justify-center
                    font-bold">

                        <%= user.username.charAt(0).toUpperCase() %>

                    </div>

                </div>

            </header>



            <section class=" flex-1 flex flex-col p-5 md:p-8">



                <div class="flex flex-col xl:flex-row xl:items-center xl:justify-between gap-6">

                    <div>

                        <h1 class="text-3xl font-bold text-slate-800">

                            <%= page %>

                        </h1>

                        <p class="text-slate-500 mt-1">

                            <% if(page==="Home" ){ %>
                                Manage all your files in one place
                                <% } else if(page==="Recent" ){ %>
                                    Your recently uploaded files
                                    <% } else if(page==="Starred" ){ %>
                                        Your starred files
                                        <% } else if(page==="Trash" ){ %>
                                            Deleted files can be restored from here.
                                            <% } else if(page==="Search" ){ %>
                                                Search results
                                                <% } %>

                        </p>

                    </div>

                   <div class="grid grid-cols-3 gap-3">

    <div class="bg-white rounded-xl shadow p-3 text-center hover:shadow-lg hover:-translate-y-1 transition-all duration-300 cursor-pointer">

        <p class="text-slate-500 text-xs">Total Files</p>

        <h2 class="text-2xl font-bold mt-1">
            <%= locals.totalFiles || 0 %>
        </h2>

    </div>

    <div class="bg-white rounded-xl shadow p-3 text-center  hover:shadow-lg hover:-translate-y-1 transition-all duration-300 cursor-pointer">

        <p class="text-slate-500 text-xs">Starred</p>

        <h2 class="text-2xl font-bold mt-1">
            ⭐ <%= locals.starredFiles || 0 %>
        </h2>

    </div>

    <div class="bg-white rounded-xl shadow p-3 text-center hover:shadow-lg hover:-translate-y-1 transition-all duration-300 cursor-pointer">

        <p class="text-slate-500 text-xs">Trash</p>

        <h2 class="text-2xl font-bold mt-1">
            🗑️ <%= locals.trashFiles || 0 %>
        </h2>

    </div>

</div>

                </div>



                <% if(files.length===0){ %>

                    <div class="flex-1 flex flex-col items-center justify-center text-center">

                        <i class="ri-folder-open-line text-8xl text-slate-300"></i>

                        <% if(page==="Trash" ){ %>

                            <h2 class="text-3xl font-bold mt-6">
                                Trash is Empty
                            </h2>

                            <p class="text-slate-500 mt-3">
                                Deleted files will appear here.
                            </p>

                            <% } else if(page==="Starred" ){ %>

                                <h2 class="text-3xl font-bold mt-6">
                                    No Starred Files
                                </h2>

                                <p class="text-slate-500 mt-3">
                                    Star important files to find them quickly.
                                </p>

                                <% } else if(page==="Recent" ){ %>

                                    <h2 class="text-3xl font-bold mt-6">
                                        No Recent Files
                                    </h2>

                                    <p class="text-slate-500 mt-3">
                                        Recently uploaded files will appear here.
                                    </p>

                                    <% } else if(page==="Search" ){ %>

                                        <h2 class="text-3xl font-bold mt-6">
                                            No Files Found
                                        </h2>

                                        <p class="text-slate-500 mt-3">
                                            Try searching with a different filename.
                                        </p>

                                        <% } else { %>

                                            <h2 class="text-3xl font-bold mt-6">
                                                Your Drive is Empty
                                            </h2>

                                            <p class="text-slate-500 mt-3">
                                                Upload your first file to get started.
                                            </p>

                                            <% } %>

                    </div>

                    <% } else { %>



                        <div class="grid
                grid-cols-1
                sm:grid-cols-2
                lg:grid-cols-3
                xl:grid-cols-4
                gap-6
                mt-10">

                            <% files.forEach(file=> { %>

                                <% let icon="ri-file-line text-blue-500" ; if(file.mimetype.includes("image"))
                                    icon="ri-image-line text-pink-500" ; else if(file.mimetype.includes("pdf"))
                                    icon="ri-file-pdf-line text-red-500" ; else if(file.mimetype.includes("word"))
                                    icon="ri-file-word-line text-blue-600" ; else if(file.mimetype.includes("excel"))
                                    icon="ri-file-excel-line text-green-600" ; else if(file.mimetype.includes("zip"))
                                    icon="ri-file-zip-line text-orange-500" ; else if(file.mimetype.includes("video"))
                                    icon="ri-video-line text-purple-500" ; else if(file.mimetype.includes("audio"))
                                    icon="ri-music-2-line text-indigo-500" ; %>

                                    <div class="bg-white
                    rounded-3xl
                    shadow-sm
                    hover:shadow-xl
                    hover:-translate-y-1
                    transition-all
                    duration-300
                    p-6">

                                        <i class="<%= icon %> text-6xl"></i>

                                        <h2 class="font-semibold
                        text-lg
                        mt-5
                        truncate">

                                            <%= file.originalname %>

                                        </h2>

                                        <p class="text-sm
                        text-slate-500
                        mt-2">

                                            <%= (file.size/1024).toFixed(2) %> KB

                                        </p>

                                        <p class="text-xs
                        text-slate-400
                        mt-1">

                                            Uploaded:
                                            <%= new Date(file.createdAt).toLocaleDateString() %>

                                        </p>

                                        <div class="mt-6">

                                            <% if(page==="Trash" ){ %>

                                                <div class="flex flex-wrap gap-2">

                                                    <a href="/file/restore/<%= file._id %>"
                                                        class="flex-1 text-center bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-xl transition">

                                                        <i class="ri-arrow-go-back-line mr-1"></i>

                                                        Restore

                                                    </a>

                                                    <a href="/file/deleteforever/<%= file._id %>"
                                                        onclick="return confirm('Delete this file forever?')"
                                                        class="flex-1 text-center bg-red-600 hover:bg-red-700 text-white px-4 py-2 rounded-xl transition">

                                                        <i class="ri-delete-bin-6-line mr-1"></i>

                                                        Delete Forever

                                                    </a>

                                                </div>

                                                <% } else { %>

                                                    <div class="flex flex-wrap gap-2">

                                                        <a href="/file/download/<%= file._id %>"
                                                            class="flex-1 text-center bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded-xl transition">

                                                            <i class="ri-download-line mr-1"></i>

                                                            Download

                                                        </a>

                                                        <a href="/file/delete/<%= file._id %>"
                                                            onclick="return confirm('Move this file to Trash?')"
                                                            class="flex-1 text-center bg-red-600 hover:bg-red-700 text-white px-4 py-2 rounded-xl transition">

                                                            <i class="ri-delete-bin-line mr-1"></i>

                                                            Delete

                                                        </a>

                                                    </div>

                                                    <div class="mt-3 flex justify-center">

                                                        <a href="/file/star/<%= file._id %>"
                                                            class="text-lg font-medium transition hover:scale-105">

                                                            <% if(file.starred){ %>

                                                                ⭐ Unstar

                                                                <% } else { %>

                                                                    ☆ Star

                                                                    <% } %>

                                                        </a>

                                                    </div>

                                                    <% } %>

                                        </div>

                                    </div>

                                    <% }) %>

                        </div>

                        <% } %>

            </section>
            <%- include("partials/footer") %>

        </main>

    </div>

    <form
    id="uploadForm"
    action="/file/upload"
    method="POST"
    enctype="multipart/form-data"
    style="display:none;"
>
    <input
        type="file"
        id="fileInput"
        name="file"
        onchange="document.getElementById('uploadForm').submit()"
    >
</form>

    <script>

        function toggleSidebar() {

            const sidebar = document.getElementById("sidebar");
            const overlay = document.getElementById("overlay");

            sidebar.classList.toggle("-translate-x-full");
            overlay.classList.toggle("hidden");

        }

        function toggleNewMenu() {
            document.getElementById("newMenu").classList.toggle("hidden");
        }


        window.addEventListener("resize", () => {

            if (window.innerWidth >= 1024) {

                document.getElementById("sidebar")
                    .classList.remove("-translate-x-full");

                document.getElementById("overlay")
                    .classList.add("hidden");

            } else {

                document.getElementById("sidebar")
                    .classList.add("-translate-x-full");

            }

        });


        document.addEventListener("click", function (e) {

            const menu = document.getElementById("newMenu");

            if (!e.target.closest("#newMenu") &&
                !e.target.closest("[onclick='toggleNewMenu()']")) {

                menu.classList.add("hidden");

            }

        });


    </script>



</body>

</html>